<Window x:Class="SmartTravelPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Travel Planner" Height="720" Width="1280">
    
    <Grid Background="{DynamicResource Theme_BackgroundBrush}">
        <Grid Margin="36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <TextBlock Text="Traveler" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="16"/> 
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Vertical">
                            <TextBlock Text="Name" FontSize="14"/>
                            <TextBox x:Name="TravelerNameTextBox" FontSize="18" Margin="0,4,0,0"/>

                            <TextBlock Text="Location" FontSize="14" Margin="0,16,0,0"/>
                            <TextBox x:Name="TravelerLocationTextBox" FontSize="18" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" x:Name="CreateTravelerBtn" Click="OnCreateTravelerBtnClick" Content="Create / Update Traveler" Height="32" Padding="12,0"/>
                            <Button Grid.Row="2" x:Name="LoadFromJsonBtn" Click="OnLoadFromJsonBtnClick" Content="Load from Json" Height="32" Padding="12,0"/>
                            <Button Grid.Row="4" x:Name="SaveTravelerBtn" Click="OnSaveTravelerBtnClick" Content="Save Traveler" Height="32" Padding="12,0"/>
                        </Grid>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Route" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="4" CornerRadius="3">
                            <TextBox x:Name="RouteTextBox"
                                     FontSize="18"
                                     TextWrapping="Wrap"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <TextBlock Text="Total Distance:" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                            <TextBlock x:Name="TotalDistanceTextBlock" Text="0" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBlock Text="km" FontSize="20" HorizontalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Vertical">
                            <TextBlock Text="City / Destination" FontSize="14" Margin="0,16,0,0"/>
                            <TextBox x:Name="CityTextBox" FontSize="18" Margin="0,4,0,0"/>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="AddCityBtn" Click="OnAddCityBtnClick" Content="Add City" Height="32"/>
                                <Button Grid.Column="2" x:Name="PlanRouteBtn" Click="OnPlanRouteBtnClick" Content="Plan Route" Height="32"/>
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="RemoveCityBtn" Click="OnRemoveCityBtnClick" Content="Remove City" Height="32"/>
                                <Button Grid.Column="2" x:Name="ClearRouteBtn" Click="OnClearRouteBtnClick" Content="Clear Route" Height="32"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>



            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Cities" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16" />
                <ListBox Grid.Row="1" x:Name="RouteListBox" BorderThickness="1" Margin="0,0,0,12">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter Margin="2,1"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Mode=OneWay}"
                                     FontSize="16"
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="0"
                                     Cursor="IBeam"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" x:Name="LoadMapBtn" Click="OnLoadMapBtnClick" Content="Load Map" Height="32"/>
                    <Button Grid.Column="2" x:Name="ExitBtn" Click="OnExitBtnClick" Content="Exit" Background="Brown" Foreground="White" Height="32"/>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>